<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>plinth</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plinth.Pipeline\Plinth.Pipeline.csproj" />
    <ProjectReference Include="..\Plinth.Api\Plinth.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="NetVips.Native.linux-x64" />
    <PackageReference Include="NetVips.Native.linux-arm64" />
  </ItemGroup>

  <!-- Only this machine needs the macOS native; a Linux publish should not carry it. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="NetVips.Native.osx-arm64" />
  </ItemGroup>

</Project>
